{
  "name": "casablanca-tools-backend",
  "private": true,
  "type": "module",
  "description": "Netlify Functions backing the Casa Blanca tools, plus the Vite build for the comp report (tools-src/comp-report/).",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.0",
    "@comp-report/anthropic-sdk": "npm:@anthropic-ai/sdk@^0.128.0",
    "@netlify/blobs": "^8.1.0",
    "@netlify/database": "^2.0.1",
    "@netlify/identity": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "build": "node agents/build.js && npm run build:comp-report",
    "build:comp-report": "vite build --config tools-src/comp-report/vite.config.ts",
    "dev:comp-report": "vite --config tools-src/comp-report/vite.config.ts",
    "typecheck": "tsc -p tools-src/comp-report",
    "check": "node agents/build.js --check",
    "test": "node --test agents/build.test.js",
    "test:comp-report": "node --test --test-concurrency=1 \"tools-src/comp-report/server/**/*.test.ts\" \"tools-src/comp-report/db/**/*.test.ts\"",
    "db:local": "node tools-src/comp-report/dev/migrate-local.ts",
    "test:engine": "node --test \"tools-src/comp-report/engine/test/**/*.test.ts\"",
    "typecheck:engine": "tsc -p tools-src/comp-report/engine && tsc -p tools-src/comp-report/engine/test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
